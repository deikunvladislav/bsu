   "value": "(* task 4 *)\r\n\r\nmatA = {{1, 2, 3}, {4, 5, 6}, {7, 8, 10}};\r\n\r\nMatrixForm[matA]\r\n\r\n(* Определитель *)\r\ndetA = Det[matA]\r\n\r\n(* Собственные значения *)\r\neigenValues = Eigenvalues[matA]\r\n\r\n(* Собственные векторы *)\r\neigenVectors = Eigenvectors[matA]\r\n\r\n(* Транспонированная матрица *)\r\nmatAT = MatrixForm[Transpose[matA]]",
