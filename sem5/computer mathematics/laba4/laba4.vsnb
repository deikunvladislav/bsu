   "kind": 2,
   "value": "(* task 5 *)\r\n\r\nmat1 = {{1, 2, 3}, {0, 1, 4}, {5, 6, 0}};\r\nmat2 = {{2, 0, 1}, {1, 3, 2}, {4, 1, 5}};\r\nMatrixForm[mat1]\r\nMatrixForm[mat1]\r\n\r\n(* Сложение *)\r\nsumMat =MatrixForm[ mat1 + mat2]\r\n\r\n(* Транспонирование первой матрицы *)\r\ntransMat1 = MatrixForm[Transpose[mat1]]\r\n\r\n(* Обратная матрица для mat1 *)\r\ninvMat1 = MatrixForm[Inverse[mat1]]\r\n\r\n(* Перемножение mat1 и mat2 *)\r\nprodMat = MatrixForm[mat1 . mat2]",
